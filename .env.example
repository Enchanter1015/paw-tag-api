NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&connection_limit=10&pool_timeout=20&connect_timeout=15
JWT_ACCESS_SECRET=change-me-to-a-random-32+-char-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-32+-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12
AWS_REGION=us-east-1
AWS_S3_BUCKET=paw-tag-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
MAX_IMAGE_UPLOAD_MB=10
MAX_IMAGES_PER_UPLOAD=10
